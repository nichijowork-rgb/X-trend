{
  "name": "x-trend",
  "version": "0.1.0",
  "private": true,
  "description": "Xの情報を集め、夜職の業界把握と投稿ネタ探しに使うツール",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
