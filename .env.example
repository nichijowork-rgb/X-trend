# コピーして .env にし、値を設定（.env はコミットしない）
PORT=8787
DATA_DIR=./data
TZ_NAME=Asia/Tokyo
# 設定すると共有リンク（閲覧）と管理者トークン（編集）が必須になります。公開運用では必ず設定。
ADMIN_TOKEN=
# X API v2（App-only Bearer）: 最近の検索・投稿の数値更新
X_BEARER_TOKEN=
# X API v2（OAuth2 ユーザー文脈）: ホームタイムライン（逆時系列。おすすめ欄ではありません）
X_USER_ACCESS_TOKEN=
X_USER_ID=
# xAI（Grok）: X検索・要約
XAI_API_KEY=
